# Local development uses a file store when MONGODB_URI is absent.
# Production requires MongoDB Atlas (or another reachable MongoDB server).
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# Set both once to initialise the teacher account. Use your own strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional AI lesson drafting. Keep the key server-side; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional port for npm run classroom (separate from the dev server).
CLASSROOM_PORT=4100

# Optional WEBSITE Google OAuth. Never prefix these with VITE_ or put them in the APK.
# Register the exact callback with a Google Web application OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional port for npm run local (ordinary signup/login, no classroom-code admission).
LOCAL_PORT=4100
