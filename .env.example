# Local development uses a file store when MONGODB_URI is absent.
# Production requires MongoDB Atlas (or another reachable MongoDB server).
MONGODB_URI=
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# Set both once to initialise the teacher account. Use your own strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional AI lesson drafting. Keep the key server-side; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional port for npm run classroom (separate from the dev server).
CLASSROOM_PORT=4100
