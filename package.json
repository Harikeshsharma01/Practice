{
  "name": "sewestian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node tests/browser.mjs",
    "test:teacher": "node tests/teacher-browser.mjs",
    "classroom": "npm run build && node scripts/start-classroom.mjs",
    "android:apk": "python3 scripts/build-android.py",
    "prebuild": "node scripts/sync-android.mjs",
    "predev": "node scripts/sync-android.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@netlify/blobs": "^11.1.3",
    "@netlify/database": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^1.0.0-beta.22",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "multer": "^2.4.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^1.0.0-beta.22",
    "prettier": "^3.9.9",
    "vite": "^7.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
